# Production Environment Configuration for KODO

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=4000
NODE_ENV=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use PostgreSQL in production for better scalability and reliability
# Backup: Create automated backups daily at 2 AM UTC
DATABASE_URL=postgresql://user:password@db-prod.example.com:5432/kodo_prod

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate a strong JWT_SECRET: openssl rand -base64 32
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_MIN_32_CHARS_CHANGE_THIS
JWT_EXPIRES_IN=7d

# Session configuration
SESSION_SECRET=YOUR_PRODUCTION_SESSION_SECRET_MIN_32_CHARS_CHANGE_THIS

# ============================================================================
# PAYMENT GATEWAYS (Live Keys)
# ============================================================================
# Stripe Live Mode
STRIPE_SECRET_KEY=sk_live_YOUR_PRODUCTION_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

# Flutterwave Live Mode
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_YOUR_PRODUCTION_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_YOUR_PRODUCTION_KEY
FLUTTERWAVE_ENCRYPTION_KEY=YOUR_PRODUCTION_ENCRYPTION_KEY

# ============================================================================
# URLS & CORS
# ============================================================================
# Update these to your production domain
FRONTEND_URL=https://app.kodo.com
BACKEND_URL=https://api.kodo.com
CORS_ALLOWED_ORIGINS=https://app.kodo.com,https://www.kodo.com

# ============================================================================
# ERROR MONITORING & LOGGING
# ============================================================================
# Sentry for error tracking and performance monitoring
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging level (production should be 'warn' or 'error')
LOG_LEVEL=warn
LOG_FILE=/var/log/kodo/app.log

# ============================================================================
# REDIS CONFIGURATION (Caching & Sessions)
# ============================================================================
REDIS_URL=redis://:PASSWORD@redis-prod.example.com:6379/0
REDIS_CACHE_TTL=3600

# ============================================================================
# EMAIL SERVICE (SMTP)
# ============================================================================
# Use your email service provider (SendGrid, AWS SES, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_FROM=noreply@kodo.com
SMTP_FROM_NAME=KODO Team

# ============================================================================
# FILE UPLOAD (Cloudinary or AWS S3)
# ============================================================================
# Using Cloudinary for image hosting
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Upload limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ============================================================================
# PUSH NOTIFICATIONS
# ============================================================================
# Firebase Cloud Messaging for mobile push notifications
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# ============================================================================
# SMS SERVICE
# ============================================================================
# BulkSMS and Termii for SMS notifications
BULKSMS_API_KEY=YOUR_BULKSMS_API_KEY
TERMII_API_KEY=YOUR_TERMII_API_KEY
SMS_SENDER_ID=KODO

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PHONE_VERIFICATION=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_ANALYTICS=true

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================
# Automatic backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM UTC
BACKUP_RETENTION_DAYS=30

# ============================================================================
# ANALYTICS & TRACKING
# ============================================================================
GOOGLE_ANALYTICS_ID=YOUR_GA_ID
AMPLITUDE_API_KEY=YOUR_AMPLITUDE_KEY

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_TIMEOUT_MS=30000
API_MAX_REQUEST_SIZE=10mb

