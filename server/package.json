{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "bcrypt": true,
    "sharp": true,
    "esbuild": true,
    "@firebase/util": true,
    "protobufjs": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  },
  "scripts": {
    "postinstall": "npx prisma generate",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "node prisma/seed/seed.js",
    "db:studio": "npx prisma studio",
    "db:verify": "node scripts/verify-migrations.js",
    "db:backup": "bash scripts/backup-db.sh",
    "prisma:generate": "npx prisma generate",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=tests/integration",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit",
    "perf:check": "node scripts/performance-check.js",
    "perf:monitor": "node scripts/performance-check.js && watch 'npm run perf:check' ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.74.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "firebase-admin": "^13.6.0",
    "flutterwave-node-v3": "^1.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mapbox-gl": "^3.16.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "stripe": "^18.3.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "sharp": "^0.34.5",
    "supertest": "^7.1.4"
  }
}
