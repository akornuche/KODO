# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://kodo_user:kodo_password@localhost:5432/kododb

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Stripe (Test Mode - Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Flutterwave (Get from https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here

# Push Notifications - Firebase (Get from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com"}
FIREBASE_PROJECT_ID=your-firebase-project-id

# Push Notifications - Web Push (Generate VAPID keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
NOTIFICATION_EMAIL=noreply@kodo.com

# SMS Providers - Termii (Primary - https://termii.com/)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=KODO

# SMS Providers - BulkSMS Nigeria (Fallback - https://bulksmsnigeria.com/)
BULKSMS_API_KEY=your_bulksms_api_key_here
BULKSMS_USERNAME=your_bulksms_username_here
BULKSMS_SENDER_ID=KODO

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (Optional - for rate limiting / caching)
REDIS_URL=redis://localhost:6379

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@kodo.com

# Logging
LOG_LEVEL=info

# File Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here