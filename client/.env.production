# Production Environment Configuration for KODO Client

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Update to your production API domain
VITE_API_BASE_URL=https://api.kodo.com
VITE_SOCKET_URL=https://api.kodo.com
VITE_API_TIMEOUT=30000

# ============================================================================
# PAYMENT GATEWAY (Stripe - Live Public Key)
# ============================================================================
VITE_STRIPE_PUBLIC_KEY=pk_live_YOUR_PRODUCTION_STRIPE_PUBLIC_KEY

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
VITE_SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/your-project-id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics
VITE_GA_ID=YOUR_PRODUCTION_GA_ID

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PWA=true

# ============================================================================
# APP CONFIGURATION
# ============================================================================
VITE_APP_NAME=KODO
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

