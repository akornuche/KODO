# Vercel Environment Variables
# Copy to Vercel Dashboard Project Settings → Environment Variables

# Database
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_PRISMA_URL=postgresql://[user]:[password]@[host]:[port]/[database]?schema=public

# Redis/Cache
REDIS_URL=redis://[user]:[password]@[host]:[port]

# JWT
JWT_SECRET=[generate-random-256-bit-string]
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=production
PORT=3000
API_URL=https://kodo.vercel.app
FRONTEND_URL=https://kodo.vercel.app

# Email Service (SendGrid)
SENDGRID_API_KEY=[your-sendgrid-api-key]
SENDGRID_FROM_EMAIL=noreply@kodo.com

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=[your-stripe-secret-key]
STRIPE_PUBLISHABLE_KEY=[your-stripe-publishable-key]
STRIPE_WEBHOOK_SECRET=[your-stripe-webhook-secret]

# Flutterwave (Optional)
FLUTTERWAVE_SECRET_KEY=[your-flutterwave-secret-key]

# Error Monitoring (Sentry)
SENTRY_DSN=[your-sentry-dsn]
SENTRY_AUTH_TOKEN=[your-sentry-auth-token]

# File Upload (Cloudinary)
CLOUDINARY_NAME=[your-cloudinary-name]
CLOUDINARY_API_KEY=[your-cloudinary-api-key]
CLOUDINARY_API_SECRET=[your-cloudinary-api-secret]

# Mapbox (for delivery tracking)
MAPBOX_TOKEN=[your-mapbox-token]

# Firebase (for push notifications - optional)
FIREBASE_PROJECT_ID=[your-firebase-project-id]
FIREBASE_PRIVATE_KEY=[your-firebase-private-key]
FIREBASE_CLIENT_EMAIL=[your-firebase-client-email]

# AWS (for backups - optional)
AWS_ACCESS_KEY_ID=[your-aws-access-key]
AWS_SECRET_ACCESS_KEY=[your-aws-secret-key]
AWS_S3_BUCKET=kodo-backups
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://kodo.vercel.app

# Feature Flags
ENABLE_SELLER_FEATURE=true
ENABLE_COURIER_FEATURE=true
ENABLE_PAYMENTS=true
ENABLE_NOTIFICATIONS=true
